{
    "name": "uae-corporate-registry-monitor",
    "version": "1.0.0",
    "type": "module",
    "description": "UAE Corporate Registry Delta Monitor: tracks Dubai mainland trade-license status changes (via Dubai Pulse open data) plus ADGM and DIFC free-zone company register changes, with bilingual Arabic/English entity normalization, pay-per-event.",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "fast-check": "^3.23.1",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "keywords": [
        "apify",
        "actor",
        "uae",
        "united arab emirates",
        "corporate registry",
        "company registry monitor",
        "adgm",
        "abu dhabi global market",
        "difc",
        "dubai international financial centre",
        "dubai pulse",
        "dubai trade license",
        "kyb",
        "aml compliance",
        "bilingual arabic english",
        "delta monitoring",
        "b2b data",
        "pay-per-event"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/stefanoseggio/uae-corporate-registry-monitor.git"
    },
    "homepage": "https://apify.com/stefano_seggio/uae-corporate-registry-monitor",
    "author": "Stefano",
    "license": "Apache-2.0"
}
